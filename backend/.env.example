# Backend Environment Variables - Phase II Todo Application
# Copy this file to .env and fill in your values

# Database Connection (Neon PostgreSQL)
# Format: postgresql+asyncpg://user:password@host/database?sslmode=require
DATABASE_URL=postgresql+asyncpg://user:password@your-neon-host.neon.tech/neondb?sslmode=require

# Better Auth JWT Secret (must match frontend BETTER_AUTH_SECRET)
BETTER_AUTH_SECRET=your-shared-secret-here

# Frontend URL for CORS (Better Auth URL)
BETTER_AUTH_URL=http://localhost:3000
